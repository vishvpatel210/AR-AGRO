PORT=5000
RECIPIENT_EMAIL=export@aragrospices.com

# SMTP Configuration — fill in your mail server credentials
# For cPanel/Hostinger hosting use: mail.yourdomain.com
SMTP_HOST=mail.aragrospices.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@aragrospices.com
SMTP_PASS=your_smtp_password
SMTP_FROM="A.R. Agro Spices" <your_smtp_user@aragrospices.com>
# Set to false for cPanel / Hostinger self-signed TLS certs
SMTP_REJECT_UNAUTHORIZED=false
